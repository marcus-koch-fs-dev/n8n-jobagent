# Vorlage: nach .env kopieren und N8N_ENCRYPTION_KEY auf einen langen Zufallswert setzen
N8N_ENCRYPTION_KEY=bitte-langen-zufallswert-eintragen
GENERIC_TIMEZONE=Europe/Berlin
# false = Browser sichtbar in noVNC (http://localhost:6080)
HEADLESS=true
# Wie viele Seiten der Browser-Dienst gleichzeitig laedt
MAX_CONCURRENCY=2
