        "jsCode": "// bis_schritt: 2 = nur Links + Seiten laden (ohne KI), 4 = alles.\nconst body = $json.body && typeof $json.body === 'object' ? $json.body : {};\nconst bis = [1, 2, 3, 4].includes(Number(body.bis_schritt)) ? Number(body.bis_schritt) : 4;\nreturn [{ json: { bis_schritt: bis, gestartet_am: new Date().toISOString() } }];"
