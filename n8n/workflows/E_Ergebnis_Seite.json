    {
      "id": "4268d5a4-f5ab-4057-9449-4960e76ae6c2",
      "name": "Eingabe prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        560
      ],
      "parameters": {
        "jsCode": "// Nie blind übernehmen, was von außen kommt: nur bekannte Aktionen und Werte zulassen.\nlet b = $json.body || {};\nif (typeof b === 'string') {\n  try {\n    b = JSON.parse(b);\n  } catch (e) {\n    b = {};\n  }\n}\nconst id = Number(b.id);\nconst aktion = String(b.aktion || '');\nlet wert = String(b.wert === undefined || b.wert === null ? '' : b.wert);\nconst TENDENZEN = ['', 'interessant', 'vielleicht', 'nein', 'beworben', 'weg']; // weg = Stelle nicht mehr verfügbar\nconst textHash = String(b.text_hash || '');\nlet fehler = '';\nif (aktion !== 'link' && (!Number.isInteger(id) || id <= 0)) fehler = 'ungültige id';\nelse if (aktion === 'tendenz' && !TENDENZEN.includes(wert)) fehler = 'ungültige Tendenz';\nelse if (aktion === 'freigabe' && !['', 'OK'].includes(wert)) fehler = 'ungültige Freigabe';\nelse if (aktion === 'notiz') wert = wert.slice(0, 2000);\nelse if (aktion === 'manuell' && !(/^[a-f0-9]{16}$/.test(wert) && /^[a-f0-9]{20}$/.test(textHash))) fehler = 'ungültiger Cache-Verweis';\nelse if (!['tendenz', 'notiz', 'freigabe', 'manuell', 'link'].includes(aktion)) fehler = 'unbekannte Aktion';\n\n// Neuer Link: gleich vereinheitlichen wie in Schritt 1 (sonst gäbe es Dubletten)\n// Hinweis: Im n8n-Code-Knoten gibt es kein \"new URL(...)\".\n// Deshalb zerlegen wir Adressen mit einem regulären Ausdruck selbst.\nfunction zerlegeUrl(roh) {\n  const m = String(roh || '').trim().match(/^(https?):\\/\\/([^\\/?#]+)([^?#]*)(\\?[^#]*)?(#.*)?$/i);\n  if (!m) return null;\n  return { protokoll: m[1].toLowerCase(), host: m[2].toLowerCase(), pfad: m[3] || '/', query: m[4] || '' };\n}\n\n// Macht aus einer relativen Weiterleitung (\"/karriere\") eine volle Adresse.\nfunction absoluteUrl(ziel, basis) {\n  if (/^https?:\\/\\//i.test(ziel)) return ziel;\n  const b = zerlegeUrl(basis);\n  if (!b) return ziel;\n  if (ziel.startsWith('//')) return b.protokoll + ':' + ziel;\n  if (ziel.startsWith('/')) return b.protokoll + '://' + b.host + ziel;\n  return b.protokoll + '://' + b.host + b.pfad.replace(/[^\\/]*$/, '') + ziel;\n}\n\n// Zeigt eine Adresse nur noch auf eine allgemeine Karriere- oder Startseite?\nfunction istAllgemeineSeite(ziel, original) {\n  const z = zerlegeUrl(ziel);\n  const o = zerlegeUrl(original);\n  if (!z || !o) return false;\n  const pfad = (u) => u.pfad.replace(/\\/+$/, '').toLowerCase();\n  const host = (u) => u.host.replace(/^www\\./, '');\n  if (host(z) === host(o) && pfad(z) === pfad(o)) return false; // z. B. nur http -> https\n  const p = pfad(z);\n  if (p === '') return true;\n  if (/^(\\/[a-z]{2}(-[a-z]{2})?)?(\\/(karriere|career|careers|jobs|job|stellenangebote|stellen|offene-stellen|jobboerse|join-us|joinus|vacancies|work-with-us|search|suche))*$/.test(p)) return true;\n  if (/[?&](error|expired|notfound|jobnotfound)=/i.test(z.query)) return true;\n  return false;\n}\nlet url = '';\nif (aktion === 'link') {\n  const u = zerlegeUrl(wert);\n  if (!u) fehler = 'Das ist kein gültiger Link (muss mit http:// oder https:// beginnen)';\n  else {\n    const params = u.query.replace(/^\\?/, '').split('&').filter(Boolean).filter((p) => !/^(utm_|gclid|fbclid|mc_|ref=|ref_|source=|trk|trackingid|_hs|hsa_)/i.test(p));\n    let pfad = u.pfad || '/';\n    if (pfad !== '/' && params.length === 0) pfad = pfad.replace(/\\/+$/, '') || '/';\n    url = `https://${u.host}${pfad}${params.length ? '?' + params.join('&') : ''}`;\n  }\n}\nconst ziel = fehler ? 'fehler' : aktion === 'freigabe' ? 'freigabe' : aktion === 'manuell' ? 'manuell' : aktion === 'link' ? 'link' : 'auswahl';\nreturn [{ json: { id, aktion, wert, url, text_hash: textHash, fehler, ziel } }];"
      },
      "notes": "Nur erlaubte Aktionen: tendenz, notiz, freigabe.",
      "notesInFlow": true
    },
