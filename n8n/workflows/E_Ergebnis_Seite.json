    {
      "id": "457f1d7e-2268-453f-bc13-407e23ed954c",
      "name": "Daten für die Seite zusammenstellen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "jsCode": "// Nur die Felder, die die Seite braucht – und deine Tendenz pro Stelle dazu.\nconst auswahl = {};\nfor (const i of $('Meine Auswahl laden').all()) if (i.json.job_id) auswahl[i.json.job_id] = i.json;\nconst einordnung = {};\nfor (const i of $('Einordnung laden').all()) if (i.json.job_id) einordnung[i.json.job_id] = i.json;\nconst tiefencheck = {};\nfor (const i of $('Tiefen-Checks laden').all()) if (i.json.job_id) tiefencheck[i.json.job_id] = i.json;\n\nconst FELDER = [\n  'id', 'url', 'domain', 'status', 'hinweis', 'freigabe', 'nicht_mehr_gelistet', 'screenshot', 'cache_id', 'duplikat_von',\n  'veroeffentlichungsdatum', 'alter_tage', 'jobtitel', 'firma', 'ort', 'remote', 'remote_regel_wortlaut', 'gehalt',\n  'vertragsform', 'bewerbungsweg', 'kurze_zusammenfassung', 'passung_score', 'bewertung', 'bewertung_begruendung',\n  'pflichtkriterien_erfuellt', 'luecken', 'offene_fragen', 'warnsignale', 'modell_bewertung', 'bewertet_am', 'erstmals_gesehen', 'linktext',\n];\nconst jobs = $('Alle Stellen laden')\n  .all()\n  .map((i) => i.json)\n  .filter((r) => r && r.id)\n  .map((r) => {\n    const o = {};\n    for (const f of FELDER) o[f] = r[f] === undefined ? null : r[f];\n    const a = auswahl[r.id] || {};\n    o.tendenz = a.tendenz || '';\n    o.notiz = a.notiz || '';\n    o.tendenz_geaendert_am = a.geaendert_am || '';\n    // Einordnung nur, wenn sie zur aktuellen Bewertung passt (sonst veraltet)\n    const ein = einordnung[r.id];\n    const aktuell = ein && ein.bewertet_am === String(r.bewertet_am || '');\n    o.bereich = ein ? ein.bereich : '';\n    o.hauptgrund = aktuell ? ein.hauptgrund : '';\n    o.beschreibung = aktuell ? ein.beschreibung : '';\n    o.einordnung_kurz = aktuell ? ein.kurz : '';\n    const tc = tiefencheck[r.id];\n    o.tc_ampel = tc ? tc.ampel : '';\n    o.tc_ergebnis = tc ? tc.ergebnis : '';\n    o.tc_modell = tc ? tc.modell : '';\n    o.tc_am = tc ? tc.geprueft_am : '';\n    return o;\n  });\nreturn [{ json: { ok: true, erzeugt_am: new Date().toISOString(), anzahl: jobs.length, jobs } }];"
      },
      "notes": "Verbindet \"jobs\" mit \"meine_auswahl\".",
      "notesInFlow": true
    },
