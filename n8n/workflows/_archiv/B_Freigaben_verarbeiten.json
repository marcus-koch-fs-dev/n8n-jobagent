      "notesInFlow": true
    },
    {
      "id": "787ac5a9-2065-4ab9-9c72-8cc04a8ccda6",
      "name": "Einstellungen anhängen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ],
      "parameters": {
        "jsCode": "const e = $('⚙️ Testlauf & Einstellungen').first().json;\n// Nur Zeilen, bei denen du \"OK\" eingetragen hast (Groß-/Kleinschreibung egal).\nreturn $input\n  .all()\n  .filter((i) => String(i.json.freigabe || '').trim().toUpperCase() === 'OK')\n  .slice(0, e.testlimit)\n  .map((i) => ({ json: { ...i.json, mit_sitzung: true, max_alter_tage: e.max_alter_tage, anbieter_override: e.anbieter_override } }));"
      },
      "notes": "Gibt jeder Stelle die Einstellungen mit.",
      "notesInFlow": true
    },
    {
      "id": "d6433836-8348-4a89-ad0d-abf45d324786",
      "name": "Schleife: eine Stelle nach der anderen",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        960,
        200
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "notes": "Gibt immer EINE Stelle weiter (Ausgang \"loop\"). Wenn alle durch sind, geht es bei \"done\" weiter.",
      "notesInFlow": true
    },
    {
