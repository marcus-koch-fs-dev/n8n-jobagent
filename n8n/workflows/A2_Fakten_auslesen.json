    {
      "id": "1afb82c8-4d18-418c-a25d-91073eb0bc15",
      "name": "Abgerufene Seiten holen",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        480,
        200
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "jobs"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "abgerufen"
            }
          ]
        },
        "returnAll": false,
        "limit": "={{ $json.testlimit }}"
      },
      "notes": "Status \"abgerufen\" (Seite liegt im Cache).",
      "notesInFlow": true,
      "alwaysOutputData": true
    },
    {
      "id": "d1992e8e-eb85-4b37-a2b5-cfd1e724349c",
      "name": "Einstellungen anhängen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ],
      "parameters": {
        "jsCode": "const e = $('⚙️ Testlauf & Einstellungen').first().json;\nreturn $input.all().map((i) => ({\n  json: { ...i.json, mit_sitzung: false, max_alter_tage: e.max_alter_tage, anbieter_override: e.anbieter_override },\n}));"
      },
      "notes": "Gibt jeder Stelle die Einstellungen mit.",
      "notesInFlow": true
    },
    {
