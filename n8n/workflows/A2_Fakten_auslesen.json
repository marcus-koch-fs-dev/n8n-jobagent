      "notesInFlow": true,
      "webhookId": "980c4ac7-1855-42ed-baf7-ba78a99491b5"
    },
    {
      "id": "b9518b9a-cba5-415e-b344-476b95f47ef5",
      "name": "Zusammenfassung",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        60
      ],
      "parameters": {
        "jsCode": "const zaehler = {};\nfor (const i of $input.all()) {\n  const s = i.json.status || (i.json.error ? 'fehler (Workflow)' : 'unbekannt');\n  zaehler[s] = (zaehler[s] || 0) + 1;\n}\nreturn [{ json: { verarbeitet: $input.all().length, nach_status: zaehler, naechster_schritt: 'Tabelle \"jobs\" ansehen, dann Workflow C (Bewertung) starten.' } }];"
      },
      "notes": "Wie viele Stellen in welchem Status gelandet sind.",
      "notesInFlow": true
    },
